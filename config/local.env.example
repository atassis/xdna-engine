# Copy to config/local.env (gitignored) for per-machine settings.
# Read by scripts/lib/data_root.sh and scripts/lib/data_root.py (and, through them, amd_paths.sh).

# Generated data (models, artifacts, caches, builds). Unset -> <repo>/data.
XDNA_DATA=/path/to/big/disk

# aiebu-asm assembles the control-code ELF. The toolchain instance builds its own (third_party/aiebu
# submodule) and it sits next to aiecc, so this is only an override -- e.g. to test a different
# aiebu-asm build without touching the instance.
#AIEBU_ASM_DIR=/path/to/aiebu/asm
