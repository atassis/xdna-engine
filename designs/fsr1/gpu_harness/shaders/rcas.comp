#version 460
// Standalone RCAS dispatch, mirrors gamescope's cs_composite_rcas.comp
#extension GL_GOOGLE_include_directive : require
// FsrRcasF call (single layer, no blend/CTM/HDR -- irrelevant to the RGB8 path here).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D u_src;
layout(binding = 1, rgba8) uniform writeonly image2D u_dst;

layout(push_constant) uniform Con {
    uvec4 con;
} pc;

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
vec4 FsrRcasLoadF(ivec2 p) { return texelFetch(u_src, p, 0); }
void FsrRcasInputF(inout float r, inout float g, inout float b) {}
#include "ffx_fsr1.h"

void main() {
    uvec2 pos = gl_GlobalInvocationID.xy;
    ivec2 sz = imageSize(u_dst);
    if (pos.x >= uint(sz.x) || pos.y >= uint(sz.y)) return;
    vec3 outColor;
    FsrRcasF(outColor.r, outColor.g, outColor.b, pos, pc.con);
    imageStore(u_dst, ivec2(pos), vec4(outColor, 1.0));
}
