# python
.venv/
.venv-iron/
__pycache__/
*.pyc

# local wheelhouse for the un-fetchable mlir_aie toolchain wheel (~290MB); repacked from the
# uv archive cache by scripts/build_wheelhouse.sh, never committed.
vendor/
# NOTE: mlir-aie/ is a pinned git submodule. Its dirty working tree (copy-forward
# kernels + build artifacts + applied patch) is hidden from the parent via
# .gitmodules ignore=all.

# model artifacts / weights (too big to commit -- keep export scripts + instructions instead)
models/
# artifacts/ is regenerable: scripts/extract_block0.py + extract_blocks.py from the ONNX
artifacts/
*.onnx
*.xclbin
*.bin
*.safetensors
*.nemo

# scratch
*.wav
*.log

# rust build artifacts
rust/target/
build/
designs/decode_fused/build/
**/build/

# local AMD-toolchain target paths (no absolute fork paths in git)
scripts/amd_toolchains.env

# stray aircc output if a build is ever run with CWD=repo-root (real output goes to artifacts/)
/air.mlir
/air_project/

# agent scaffolding and the private companion working copy must never be tracked here
.claude/
journal/
strategy/
STARTER_PROMPT*.md
# parity-test bake output (regenerated by `cargo test`)
/target/test-arenas/

# Generated brick-verification artifacts (rebuilt by the verify scripts)
aie_kernels/_test/gen/

# toolchain instance cache (toolchain instances, mlir-distro, ccache, goldens) and the
# root-level cargo target (~5GB). No trailing slash on .cache: it may legitimately be a
# SYMLINK to a shared cache outside the repo (see scripts/cache_env.sh), and `/.cache/`
# matches only a real directory -- which would leave that symlink untracked-but-committable.
/.cache
/target/

# whole_array probe build output (per-pin dirs are disposable, like probes/build)
experiments/probes/build*/

# per-worktree cargo target-dir, written by scripts/setup_worktree.sh
/.cargo/
