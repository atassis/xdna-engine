##===----------------------------------------------------------------------===##
#
# WHOLE-ARRAY (8-column) fused matmul + bias (+ optional SiLU): ONE xclbin
# computes silu(A@B+bias) [silu mode] or A@B+bias [bias mode], bf16 in/out,
# f32 in-core accumulate, across all n_aie_cols columns. Reuses the
# matrix_multiplication makefile-common build machinery.
#
# Invoke with:  make -f Makefile.silu NPU2=1 M=.. K=.. N=.. n_aie_cols=8 [no_silu=1]
#
srcdir := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))
subdir=whole_array
targetname=whole_array_modal

# Final GEMM dims (default = FFN linear1; K here is the AUGMENTED K = K_real + k)
M?=512
K?=800
N?=3072

# Single AIE-core tile dims
m?=32
k?=32
n?=32

n_aie_cols?=8
b_col_maj?=0

# bf16 in, f32 accumulate (matmul), bf16 out (after epilogue)
dtype_in?=bf16
dtype_out?=f32

# silu mode (default) vs bias-only (no activation) vs gelu mode vs glu mode
no_silu?=0
gelu?=0
# glu: out = a*sigmoid(g) over the tile's [value|gate] halves (conv-module pw1). Needs W1's columns
# permuted at weight load; without that the pairing is wrong and silent. Drain stays full width.
glu?=0

# mmul sub-tile dims, consumed ONLY by the GLU epilogue (every other mode is per-element and so
# layout-blind). Must match what mm.cc was built with: 8,8 for the bfp16 path, 4,8 native.
epi_r?=$(if $(filter 1,${emulate_bfloat16_mmul_with_bfp16}),8,4)
epi_t?=8

# Round-to-nearest-even for the f32-out modal epilogue (and, because rounding is a core control
# register, for the following tile's bfp16 matmul conversions). Default 0 = hardware default.
round_even?=0

# SiLU sigmoid precision ladder: _tail does the (t+1)*0.5 in f32 (kills the bf16 add);
# _tanh also returns tanh in f32 (kills the narrow entirely). Both default off.
silu_f32_tail?=0
silu_f32_tanh?=0

# Drain C panel-major as [N/W, M, W] instead of row-major [M, N] (0 = off). Must equal
# n_aie_cols*n. Folds the fc1->fc2 K-panel packing into the GEMM's own output DMA, so the
# K-split consumer reads each panel as a contiguous device sub-buffer. CONTROL-CODE-ONLY: the
# xclbin is byte-identical to the row-major build, only the instruction stream differs.
c_panel_width?=0

# Drive the core's K-tile loop bound from rtp[1] instead of baking K//k (0 = off). Makes the array
# program independent of K -- VERIFIED: the region above aie.runtime_sequence is bit-identical at
# K=1024 and K=4096 with this on, and differs in all 32 core bodies with it off. That is what lets a
# wide-K GEMM be an instruction stream on an existing resident instead of a whole extra design, which
# is what made the K=4096 fc2 lose in July. Tagged into the artifact name because the xclbin IS
# different from the baked one -- and every stream dispatched on it must carry the rtp[1] write.
k_loop_rtp?=0

# Carry resadd as MODE 4 of this xclbin instead of as a sibling one (0 = off). It reuses the GEMM's
# own A/B input channels and C drain and declares nothing: a second TOPOLOGY cannot route, because
# the GEMM already holds core DMA 2/2, East/South/West 4/4 and memtile DMA 6/6. Different xclbin
# (the core carries a second body), so it is tagged.
mode_resadd?=0
# Bake rtp[0]=4 into THIS instruction stream (0 = off). Insts-only: same xclbin as the
# mode_resadd=1 GEMM stream, so the pair is one program serving two ops.
rtp_mode_resadd?=0
# Bisect arms for the mode-4 hang (1-8), plus arm 9 = ACCADD, which is not a bisect: it carries the
# encoder's fc2 K-split accumulator, whose `a` operand is f32, through the GEMM's bf16 A fifo by
# reinterpreting the tile's bytes. Halves the mode's element count (2048 bf16 = 1024 f32) and keeps
# arm 8's identity detour, which is what makes the add complete.
mode4_bisect?=0
# Move the mode-4 branch behind the first A/B objectFIFO acquire instead of reading rtp[0] at the
# top of the tile (0 = off). rtp[0] carries a MEASURED one-tile visibility lag -- the barrier that
# orders it sits outside the tile loop, so each core's FIRST tile after a mode change runs the
# previous dispatch's body. Different core ELF, so it is tagged.
mode_read_late?=0
# Same peel, applied to rtp[1] (the K-tile trip count) instead of rtp[0] (0 = off). Needs
# k_loop_rtp=1. A stale k_trip is worse than a stale mode: the trip count decides how many A/B
# pairs a tile consumes, so one wrong read desynchronises the fifos for every later dispatch --
# which is why two streams with DIFFERENT K on one hardware context corrupt each other while
# uniform-K sequences are bit-exact. Different core ELF, so it is tagged.
k_read_late?=0
# Extra compile flags for the EPILOGUE object only (empty = the family's -O2). The mode-4 hang
# tracks a scheduling decision, not a source construct, so testing it needs a codegen knob: a
# suppressed source pragma left the ELF byte-identical. Tagged, and stamped, or an arm would
# reuse the previous object.
epi_opt?=

# Build the resadd body ALONE -- no matmul in the core ELF. Discriminator for the mode-4 hang:
# same shapes, same borrowed topology, same stream contract as mode_resadd=1, one variable
# changed. Mutually exclusive with mode_resadd.
resadd_only?=0

# --mode-lnaffcast COLS: put the LN + affine + f32->bf16 cast body in the xclbin, over rows of
# COLS columns; rtp_mode_lnaffcast=1 bakes rtp[0]=18 into THIS stream to select it. BF16-OUT only.
# The mode has its OWN fill contract (COLS-derived A slabs + 1 B + 1 C drain per tile), not the
# GEMM's k_trip pairing, so the rtp arm is a different INSTRUCTION STREAM on the same xclbin.
mode_lnaffcast?=0
rtp_mode_lnaffcast?=0
# Rows one lnaffcast dispatch covers (0 = the most the declared A/C tensors hold). c_fanout gives
# each column its own output region: the columns of an array row share an A fifo and so compute
# the SAME rows, and separating them lets a probe check the copies agree.
lnaffcast_rows?=0
lnaffcast_c_fanout?=0
# Rounds per TaskGroup in the mode's sequence. tg.finish() is a host-side await, so 1 serialises
# every round boundary; the GEMM finishes twice for a whole 512x1024x1024 for the same reason.
lnaffcast_group_rounds?=1
# TIMING-ONLY control for the 16 B burst claim: give the named taps (subset of abc) contiguous
# strides at unchanged sizes/offset/footprint. The output is wrong by construction, so an arm
# built with this is comparable on wall clock and on nothing else.
lnaffcast_contig_taps?=
# Swap which operand carries which thing: x on B (per column) and gb on A (per row,
# broadcast). x on A makes the 8 columns of an array row compute the SAME output rows --
# 4 useful C tiles per round of 32 -- because they share one A fifo. Changes the array
# program (a different apply kernel and a skip on B), so it tags the body.
lnaffcast_1x?=0

# --mode-resadd2a: `out = a + scale*b` with BOTH operands on the A fifo, f32-out only.
# rtp_mode_resadd2a=1 bakes rtp[0]=5 into THIS stream to select it. rows and scale are
# insts-only, so every (rows, scale) shares one xclbin.
mode_resadd2a?=0
rtp_mode_resadd2a?=0
# Put scale*b on the bf16 datapath. The f32 aie::mul is MEASURED to hang the core; b is already
# bf16 and scale is a constant, so the product is one vmul into an accfloat and is bit-exact for
# any bf16-representable scale.
resadd2a_bf16mul?=0
resadd2a_rows?=0
# Fill the array rows far-end-first. Insts-only -- same array program -- so it shares an xclbin
# with the forward arm and the comparison carries no program transition.
resadd2a_rev_rows?=0
# The identity detour max(s, s-1) that routes an f32 sum through the vector file. It was added for
# the accumulator-store hazard, and this mode's store is already `vst x0` from the vector file, so
# its justification does not apply here -- but it is f32 vector arithmetic Peano must emulate, and
# the hang is MAGNITUDE-dependent, so it is an arm. 1 = on (default), 0 = off.
resadd2a_vfile?=1
# Fuse the product into the accumulate (one aie::mac instead of aie::mul + aie::add). Needs
# resadd2a_bf16mul=1. See the header of mm_mode_resadd2a.cc for both reasons.
resadd2a_mac?=0
# Force apply to STORE instead of read-modify-write, whatever resadd2a_noop says. The arm that
# needs it is both-bodies-real with no C read -- the co-residency cell.
resadd2a_no_c_read?=0
# Runs the stage body walks (default = all of them). Varies WORK with body count held fixed.
resadd2a_stage_runs?=0
resadd2a_scale?=1.0
# 1 = compile the mode's two entry points EMPTY (the stream-contract discriminator).
resadd2a_noop?=0
# Which side undoes C_L2L3. 0 = the derived C tap (16 B bursts, 56.8% of the mode's
# dispatch time); 1 = the CORE, writing scattered so the contiguous tap is the correct
# one -- so a correct scatter arm is `lnaffcast_scatter_c=1 lnaffcast_contig_taps=c`,
# and either half alone returns the permuted output. Changes the core ELF, not the
# stream, so it tags the body.
lnaffcast_scatter_c?=0

# Read A from a [K/W, M, W] panel-major buffer instead of row-major [M, K] (0 = off). Mirror of
# c_panel_width, for a GEMM whose producer already drained panel-major -- fc1 does, by default, so a
# wide-K fc2 needs no repack. Insts-only. Needs N/n/n_aie_cols == 1: the panel index spends the A
# TAP's outer repeat dimension, and the shim BD has only four.
a_panel_width?=0

# Two kernel objects: the matmul (mm.cc) and the fused epilogue.
kernels=mm_${m}x${k}x${n} mm_silu_epilogue_${m}x${k}x${n}$(if $(filter 0,${mode_lnaffcast}),, mm_mode_lnaffcast_${m}x${k}x${n})$(if $(filter 0,${mode_resadd2a}),, mm_mode_resadd2a_${m}x${k}x${n})

aieargs+=-m $m -k $k -n $n --n-aie-cols ${n_aie_cols} --b-col-maj ${b_col_maj}
ifeq (${no_silu}, 1)
aieargs+=--no-silu
endif
ifeq (${gelu}, 1)
aieargs+=--gelu
endif
ifeq (${glu}, 1)
aieargs+=--glu
endif
ifneq (${c_panel_width}, 0)
aieargs+=--c-panel-width ${c_panel_width}
endif
ifeq (${k_loop_rtp}, 1)
aieargs+=--k-loop-rtp
endif
ifeq (${mode_resadd}, 1)
aieargs+=--mode-resadd
endif
ifeq (${rtp_mode_resadd}, 1)
aieargs+=--rtp-mode-resadd
endif
ifeq (${resadd_only}, 1)
aieargs+=--resadd-only
endif
ifeq (${mode_read_late}, 1)
aieargs+=--mode-read-late
endif
ifeq (${k_read_late}, 1)
aieargs+=--k-read-late
endif
ifneq (${a_panel_width}, 0)
aieargs+=--a-panel-width ${a_panel_width}
endif
ifneq (${mode_lnaffcast}, 0)
aieargs+=--mode-lnaffcast ${mode_lnaffcast}
endif
ifeq (${rtp_mode_lnaffcast}, 1)
aieargs+=--rtp-mode-lnaffcast
endif
ifneq (${lnaffcast_rows}, 0)
aieargs+=--lnaffcast-rows ${lnaffcast_rows}
endif
ifeq (${lnaffcast_c_fanout}, 1)
aieargs+=--lnaffcast-c-fanout
endif
ifneq (${lnaffcast_group_rounds}, 1)
aieargs+=--lnaffcast-group-rounds ${lnaffcast_group_rounds}
endif
ifneq (${lnaffcast_contig_taps},)
aieargs+=--lnaffcast-contig-taps ${lnaffcast_contig_taps}
endif
ifeq (${lnaffcast_1x}, 1)
aieargs+=--lnaffcast-1x
endif
ifeq (${mode_resadd2a}, 1)
aieargs+=--mode-resadd2a
endif
ifeq (${rtp_mode_resadd2a}, 1)
aieargs+=--rtp-mode-resadd2a
endif
ifeq (${resadd2a_rev_rows}, 1)
aieargs+=--resadd2a-rev-rows
endif
ifneq (${resadd2a_rows}, 0)
aieargs+=--resadd2a-rows ${resadd2a_rows}
endif
ifneq (${resadd2a_scale}, 1.0)
aieargs+=--resadd2a-scale ${resadd2a_scale}
endif

# Distinct suffix so silu/bias/gelu artifacts never collide with the plain matmul's.
mode_tag=$(if $(filter 1,${glu}),modalglu,$(if $(filter 1,${gelu}),modalgelu,$(if $(filter 1,${no_silu}),modalid,modalsilu)))
# ...and a panel-major drain is a DIFFERENT instruction stream on the SAME xclbin, so it
# needs its own artifact name or it would overwrite the row-major stream. A bf16-out build
# is a different xclbin outright (the C buffers resize), so it is tagged too.
dep_tag=$(if $(filter 2,$(WA_C_DEPTH)),d2,)
# Any A/B depth other than 2 is a DIFFERENT xclbin (the L1 buffers resize), so it needs its own name
# or a feed-rate sweep arm silently overwrites the depth-2 stream. Unset is depth 2 -- the generator
# defaults both knobs to fifo_depth=2 -- so only an explicit non-2 override earns a tag.
abdep_tag=$(if $(filter-out 2,$(WA_AB_DEPTH)),ab$(WA_AB_DEPTH),)
# Same rule one hop up: WA_L3L2_DEPTH resizes the shim->memtile buffers.
l3dep_tag=$(if $(filter-out 2,$(WA_L3L2_DEPTH)),l3$(WA_L3L2_DEPTH),)
# Same rule for the traced WORKER. It changes only which core carries the trace packets, but that is
# both a different xclbin and a different MEASUREMENT: A multicasts down a column and B across a row,
# so each worker sits at the intersection of two DIFFERENT 4-core rendezvous and the feed-overlap
# quantity is non-uniform by construction. Worker 0 is the generator default and stays untagged so
# banked artifact names survive. filter-out, not filter, so an empty value yields no tag rather
# than a bare "w".
wrk_tag=$(if $(filter-out 0,$(wa_trace_worker)),w$(wa_trace_worker),)
# A traced MEMTILE adds a second trace unit and a second packet route, so it is a different xclbin
# again. -1 is off and stays untagged.
mt_tag=$(if $(filter-out -1,$(wa_trace_memtile)),mt$(wa_trace_memtile),)
nat_tag=$(if $(filter 1,${emulate_bfloat16_mmul_with_bfp16}),,nat)
re_tag=$(if $(filter 1,${round_even}),re,)$(if $(filter 1,${silu_f32_tail}),ft,)$(if $(filter 1,${silu_f32_tanh}),fh,)
panel_tag=$(if $(filter 0,${c_panel_width}),,panel${c_panel_width})
out_tag=$(if $(filter bf16,${dtype_out}),bf16out,)
krtp_tag=$(if $(filter 1,${k_loop_rtp}),krtp,)
resadd_tag=$(if $(filter 1,${mode_resadd}),resadd,)
# The rtp arm is a DIFFERENT INSTRUCTION STREAM on the SAME xclbin, so it needs its own artifact
# name or it overwrites the GEMM stream -- the same rule panel_tag carries.
rtpresadd_tag=$(if $(filter 1,${rtp_mode_resadd}),rtp4,)
# The resadd body alone is a different core ELF, and each bisect arm compiles a different one --
# untagged, arms silently overwrite each other's xclbin and a rerun measures the previous build.
raonly_tag=$(if $(filter 1,${resadd_only}),raonly,)
bisect_tag=$(if $(filter 0,${mode4_bisect}),,bis${mode4_bisect})
mrl_tag=$(if $(filter 1,${mode_read_late}),mrl,)
krl_tag=$(if $(filter 1,${k_read_late}),krl,)
opt_tag=$(if ${epi_opt},$(subst -,,$(subst =,,$(subst $(space),,${epi_opt}))),)
apanel_tag=$(if $(filter 0,${a_panel_width}),,apanel${a_panel_width})
# The lnaffcast BODY is a different core ELF; the rtp arm is a different instruction stream on
# that same xclbin. rows/fanout change only the stream, so they tag the stream and not the body.
lnaff_tag=$(if $(filter 0,${mode_lnaffcast}),,lnaff${mode_lnaffcast})$(if $(filter 0,${lnaffcast_scatter_c}),,scat$(patsubst 1,,${lnaffcast_scatter_c}))$(if $(filter 1,${lnaffcast_1x}),1x,)
r2a_tag=$(if $(filter 0,${mode_resadd2a}),,r2a)$(if $(filter 0,${resadd2a_noop}),,noop$(patsubst 1,,${resadd2a_noop}))$(if $(filter 0,${resadd2a_bf16mul}),,bf16m)$(if $(filter 1,${resadd2a_vfile}),,novf)$(if $(filter 0,${resadd2a_mac}),,mac)$(if $(filter 0,${resadd2a_no_c_read}),,nord)$(if $(filter 0,${resadd2a_stage_runs}),,sr${resadd2a_stage_runs})
rtpr2a_tag=$(if $(filter 1,${rtp_mode_resadd2a}),rtp5,)$(if $(filter 1,${resadd2a_rev_rows}),revr,)$(if $(filter 0,${resadd2a_rows}),,r${resadd2a_rows})$(if $(filter 1.0,${resadd2a_scale}),,s$(subst .,,${resadd2a_scale}))
rtplnaff_tag=$(if $(filter 1,${rtp_mode_lnaffcast}),rtp18,)$(if $(filter 0,${lnaffcast_rows}),,r${lnaffcast_rows})$(if $(filter 1,${lnaffcast_c_fanout}),fan,)$(if $(filter 1,${lnaffcast_group_rounds}),,g${lnaffcast_group_rounds})$(if ${lnaffcast_contig_taps},ctg${lnaffcast_contig_taps},)
target_suffix=${M}x${K}x${N}_${m}x${k}x${n}_${n_aie_cols}c_${mode_tag}${out_tag}${panel_tag}${dep_tag}${abdep_tag}${l3dep_tag}${wrk_tag}${mt_tag}${re_tag}${nat_tag}${krtp_tag}${apanel_tag}${resadd_tag}${rtpresadd_tag}${raonly_tag}${bisect_tag}${mrl_tag}${krl_tag}${lnaff_tag}${rtplnaff_tag}${r2a_tag}${rtpr2a_tag}${opt_tag}

use_iron=1
aie_py_src=whole_array_modal_iron.py

# Linear buffer allocation (bank-aware tends to overflow with the extra acc bufs)
buffer_aloc_flag=basic-sequential

# matmul object needs the bf16_f32 combo defines (mm.cc names symbols by combo).
MM_DEFINES=-Dbf16_f32_ONLY -DDIM_M=${m} -DDIM_K=${k} -DDIM_N=${n} -DVECTORIZED_ONLY
EPI_DEFINES=$(if $(filter 1,${mode4_bisect}), -DMODE4_BISECT_STORE_ONLY,)$(if $(filter 2,${mode4_bisect}), -DMODE4_BISECT_LOAD_A,)$(if $(filter 3,${mode4_bisect}), -DMODE4_BISECT_LOAD_AB,)$(if $(filter 4,${mode4_bisect}), -DMODE4_BISECT_LOAD_AB -DMODE4_BISECT_ADD,)$(if $(filter 5,${mode4_bisect}), -DMODE4_BISECT_LOAD_AB -DMODE4_BISECT_SUB,)$(if $(filter 6,${mode4_bisect}), -DMODE4_BISECT_LOAD_AB -DMODE4_BISECT_ADD_VIAVEC,)$(if $(filter 7,${mode4_bisect}), -DMODE4_BISECT_LOAD_AB -DMODE4_BISECT_ADD -DMODE4_BISECT_NOPIPE,)$(if $(filter 8,${mode4_bisect}), -DMODE4_BISECT_LOAD_AB -DMODE4_BISECT_ADD_IDENTDETOUR,)$(if $(filter 9,${mode4_bisect}), -DMODE4_ACCADD,) -DEPI_M=${m} -DEPI_K=${k} -DEPI_N=${n} -DEPI_R=${epi_r} -DEPI_T=${epi_t}$(if $(filter 0,${lnaffcast_scatter_c}),, -DLNA_SCATTER_C=${lnaffcast_scatter_c})$(if $(filter 1,${round_even}), -DMODAL_ROUND_EVEN,)$(if $(filter 1,${drain_round_floor}), -DMODAL_DRAIN_ROUND_FLOOR,)$(if $(filter 1,${silu_f32_tail}), -DSILU_F32_TAIL,)$(if $(filter 1,${silu_f32_tanh}), -DSILU_F32_TANH,)
ifeq (${b_col_maj}, 1)
	MM_DEFINES+=-DB_COL_MAJ
endif

include ${srcdir}/../makefile-common

# Re-supply the aiecc-from-MLIR flow the blessed instance's new makefile-common dropped
# (shared with Makefile.modal.int8 and the Phase-3 whole_array siblings). srcdir points at
# the mlir-aie example dir this Makefile is copied into, so reach back to the source tree.
include ${srcdir}/../../../../../route_b_kernels/whole_array_fused/route_b_override.mk

# matmul object: bf16 in, f32 acc. KERNEL_DEFINES carries the BFP16_IREE / emulate flags from
# route_b_override.mk (fast tile) -- without it a fast-flagged build silently compiles the native kernel.
# Same identity trap as the epilogue object below: the name carries only m/k/n, but the content
# depends on MM_DEFINES + KERNEL_DEFINES (bfp16_iree, emulate_bfloat16_mmul_with_bfp16, B_COL_MAJ).
# Without the stamp, flipping any of those relinks the PREVIOUS variant's object into a new xclbin.
build/.mm_defines.stamp: FORCE
	@mkdir -p ${@D}
	@echo '${MM_DEFINES} emu=${emulate_bfloat16_mmul_with_bfp16} iree=${bfp16_iree} bcm=${b_col_maj}' | cmp -s - $@ \
	  || echo '${MM_DEFINES} emu=${emulate_bfloat16_mmul_with_bfp16} iree=${bfp16_iree} bcm=${b_col_maj}' > $@

build/mm_${m}x${k}x${n}.o: ${kernels_dir}/mm.cc build/.mm_defines.stamp
	mkdir -p ${@D}
	cd ${@D} && ${KERNEL_CC} ${KERNEL_CFLAGS} ${MM_DEFINES} ${KERNEL_DEFINES} -c $< -o ${@F}

# Epilogue object: f32 acc -> silu/narrow -> bf16 out.
#
# The object name carries only m/k/n, but its CONTENT depends on EPI_DEFINES (round_even,
# silu_f32_tail, silu_f32_tanh, ...). Without the stamp below, make sees an up-to-date .o and
# silently links the PREVIOUS variant's object into a differently-named xclbin -- so an A/B over
# those knobs compares two identical binaries and reports "no effect". That produced a false
# negative here on 2026-07-28 and nearly shipped a wrong conclusion; the stamp makes a defines
# change dirty the object.
build/.epi_defines.stamp: FORCE
	@mkdir -p ${@D}
	@echo '${EPI_DEFINES} ${epi_opt}' | cmp -s - $@ || echo '${EPI_DEFINES} ${epi_opt}' > $@
FORCE:
.PHONY: FORCE

build/mm_silu_epilogue_${m}x${k}x${n}.o: ${kernels_dir}/mm_silu_epilogue.cc build/.epi_defines.stamp
	mkdir -p ${@D}
	cd ${@D} && ${KERNEL_CC} ${KERNEL_CFLAGS} ${EPI_DEFINES} ${epi_opt} -c $< -o ${@F}

# lnaffcast mode object. Its own .cc rather than the epilogue's, because AIEAssignCoreLinkFiles
# traces only direct func.call edges from the core -- an object this one CALLED would never reach
# the link line. LNA_COLS is a build parameter and shares the epilogue's EPI_M/K/N, which are what
# fix the slab and row counts, so the same stamp dirties it.
# A MODE OBJECT NEEDS ITS OWN STAMP. .epi_defines.stamp carries EPI_DEFINES only, so a mode whose
# arm lives in a define of its own (LNA_COLS, RESADD2A_NOOP) is invisible to it: the object name is
# the same for every arm, the source is unchanged, and make relinks the PREVIOUS arm's object into
# the new xclbin. That is the same fault the stamp above was added for, and it recurred twice --
# 2026-07-28 on epi_opt, and 2026-08-24 on RESADD2A_NOOP, where arms 5 and 6 came out with
# byte-identical core ELFs. It only surfaced because the arms were diffed before being run.
# See a-conditional-define-that-drops-its-value-measures-one-arm-as-three.
LNAFF_DEFINES=-DLNA_COLS=${mode_lnaffcast}
R2A_DEFINES=$(if $(filter 0,${resadd2a_noop}),, -DRESADD2A_NOOP=${resadd2a_noop})$(if $(filter 0,${resadd2a_bf16mul}),, -DRESADD2A_BF16_MUL=1)$(if $(filter 1,${resadd2a_vfile}),, -DRESADD2A_VFILE_DETOUR=0)$(if $(filter 0,${resadd2a_mac}),, -DRESADD2A_MAC=1)$(if $(filter 0,${resadd2a_no_c_read}),, -DRESADD2A_NO_C_READ=1)$(if $(filter 0,${resadd2a_stage_runs}),, -DRESADD2A_STAGE_RUNS=${resadd2a_stage_runs})

build/.lnaffcast_defines.stamp: FORCE
	@mkdir -p ${@D}
	@echo '${EPI_DEFINES} ${LNAFF_DEFINES}' | cmp -s - $@ || echo '${EPI_DEFINES} ${LNAFF_DEFINES}' > $@

build/.resadd2a_defines.stamp: FORCE
	@mkdir -p ${@D}
	@echo '${EPI_DEFINES} ${R2A_DEFINES}' | cmp -s - $@ || echo '${EPI_DEFINES} ${R2A_DEFINES}' > $@

build/mm_mode_lnaffcast_${m}x${k}x${n}.o: ${kernels_dir}/mm_mode_lnaffcast.cc build/.lnaffcast_defines.stamp
	mkdir -p ${@D}
	cd ${@D} && ${KERNEL_CC} ${KERNEL_CFLAGS} ${EPI_DEFINES} ${LNAFF_DEFINES} -c $< -o ${@F}

# both-on-A resadd mode object. Its own .cc for the same reason lnaffcast's is: an object the
# core CALLS is not traced by AIEAssignCoreLinkFiles and never reaches the link line.
build/mm_mode_resadd2a_${m}x${k}x${n}.o: ${kernels_dir}/mm_mode_resadd2a.cc build/.resadd2a_defines.stamp
	mkdir -p ${@D}
	cd ${@D} && ${KERNEL_CC} ${KERNEL_CFLAGS} ${EPI_DEFINES}${R2A_DEFINES} -c $< -o ${@F}
