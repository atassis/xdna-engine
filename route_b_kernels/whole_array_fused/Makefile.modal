##===----------------------------------------------------------------------===##
#
# WHOLE-ARRAY (8-column) fused matmul + bias (+ optional SiLU): ONE xclbin
# computes silu(A@B+bias) [silu mode] or A@B+bias [bias mode], bf16 in/out,
# f32 in-core accumulate, across all n_aie_cols columns. Reuses the
# matrix_multiplication makefile-common build machinery.
#
# Invoke with:  make -f Makefile.silu NPU2=1 M=.. K=.. N=.. n_aie_cols=8 [no_silu=1]
#
srcdir := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))
subdir=whole_array
targetname=whole_array_modal

# Final GEMM dims (default = FFN linear1; K here is the AUGMENTED K = K_real + k)
M?=512
K?=800
N?=3072

# Single AIE-core tile dims
m?=32
k?=32
n?=32

n_aie_cols?=8
b_col_maj?=0

# bf16 in, f32 accumulate (matmul), bf16 out (after epilogue)
dtype_in?=bf16
dtype_out?=f32

# silu mode (default) vs bias-only (no activation) vs gelu mode vs glu mode
no_silu?=0
gelu?=0
# glu: out = a*sigmoid(g) over the tile's [value|gate] halves (conv-module pw1). Needs W1's columns
# permuted at weight load; without that the pairing is wrong and silent. Drain stays full width.
glu?=0

# mmul sub-tile dims, consumed ONLY by the GLU epilogue (every other mode is per-element and so
# layout-blind). Must match what mm.cc was built with: 8,8 for the bfp16 path, 4,8 native.
epi_r?=$(if $(filter 1,${emulate_bfloat16_mmul_with_bfp16}),8,4)
epi_t?=8

# Round-to-nearest-even for the f32-out modal epilogue (and, because rounding is a core control
# register, for the following tile's bfp16 matmul conversions). Default 0 = hardware default.
round_even?=0

# SiLU sigmoid precision ladder: _tail does the (t+1)*0.5 in f32 (kills the bf16 add);
# _tanh also returns tanh in f32 (kills the narrow entirely). Both default off.
silu_f32_tail?=0
silu_f32_tanh?=0

# Drain C panel-major as [N/W, M, W] instead of row-major [M, N] (0 = off). Must equal
# n_aie_cols*n. Folds the fc1->fc2 K-panel packing into the GEMM's own output DMA, so the
# K-split consumer reads each panel as a contiguous device sub-buffer. CONTROL-CODE-ONLY: the
# xclbin is byte-identical to the row-major build, only the instruction stream differs.
c_panel_width?=0

# Drive the core's K-tile loop bound from rtp[1] instead of baking K//k (0 = off). Makes the array
# program independent of K -- VERIFIED: the region above aie.runtime_sequence is bit-identical at
# K=1024 and K=4096 with this on, and differs in all 32 core bodies with it off. That is what lets a
# wide-K GEMM be an instruction stream on an existing resident instead of a whole extra design, which
# is what made the K=4096 fc2 lose in July. Tagged into the artifact name because the xclbin IS
# different from the baked one -- and every stream dispatched on it must carry the rtp[1] write.
k_loop_rtp?=0

# Carry resadd as MODE 4 of this xclbin instead of as a sibling one (0 = off). It reuses the GEMM's
# own A/B input channels and C drain and declares nothing: a second TOPOLOGY cannot route, because
# the GEMM already holds core DMA 2/2, East/South/West 4/4 and memtile DMA 6/6. Different xclbin
# (the core carries a second body), so it is tagged.
mode_resadd?=0
# Bake rtp[0]=4 into THIS instruction stream (0 = off). Insts-only: same xclbin as the
# mode_resadd=1 GEMM stream, so the pair is one program serving two ops.
rtp_mode_resadd?=0
mode4_bisect?=0

# Read A from a [K/W, M, W] panel-major buffer instead of row-major [M, K] (0 = off). Mirror of
# c_panel_width, for a GEMM whose producer already drained panel-major -- fc1 does, by default, so a
# wide-K fc2 needs no repack. Insts-only. Needs N/n/n_aie_cols == 1: the panel index spends the A
# TAP's outer repeat dimension, and the shim BD has only four.
a_panel_width?=0

# Two kernel objects: the matmul (mm.cc) and the fused epilogue.
kernels=mm_${m}x${k}x${n} mm_silu_epilogue_${m}x${k}x${n}

aieargs+=-m $m -k $k -n $n --n-aie-cols ${n_aie_cols} --b-col-maj ${b_col_maj}
ifeq (${no_silu}, 1)
aieargs+=--no-silu
endif
ifeq (${gelu}, 1)
aieargs+=--gelu
endif
ifeq (${glu}, 1)
aieargs+=--glu
endif
ifneq (${c_panel_width}, 0)
aieargs+=--c-panel-width ${c_panel_width}
endif
ifeq (${k_loop_rtp}, 1)
aieargs+=--k-loop-rtp
endif
ifeq (${mode_resadd}, 1)
aieargs+=--mode-resadd
endif
ifeq (${rtp_mode_resadd}, 1)
aieargs+=--rtp-mode-resadd
endif
ifneq (${a_panel_width}, 0)
aieargs+=--a-panel-width ${a_panel_width}
endif

# Distinct suffix so silu/bias/gelu artifacts never collide with the plain matmul's.
mode_tag=$(if $(filter 1,${glu}),modalglu,$(if $(filter 1,${gelu}),modalgelu,$(if $(filter 1,${no_silu}),modalid,modalsilu)))
# ...and a panel-major drain is a DIFFERENT instruction stream on the SAME xclbin, so it
# needs its own artifact name or it would overwrite the row-major stream. A bf16-out build
# is a different xclbin outright (the C buffers resize), so it is tagged too.
dep_tag=$(if $(filter 2,$(WA_C_DEPTH)),d2,)
# Any A/B depth other than 2 is a DIFFERENT xclbin (the L1 buffers resize), so it needs its own name
# or a feed-rate sweep arm silently overwrites the depth-2 stream. Unset is depth 2 -- the generator
# defaults both knobs to fifo_depth=2 -- so only an explicit non-2 override earns a tag.
abdep_tag=$(if $(filter-out 2,$(WA_AB_DEPTH)),ab$(WA_AB_DEPTH),)
# Same rule one hop up: WA_L3L2_DEPTH resizes the shim->memtile buffers.
l3dep_tag=$(if $(filter-out 2,$(WA_L3L2_DEPTH)),l3$(WA_L3L2_DEPTH),)
# Same rule for the traced WORKER. It changes only which core carries the trace packets, but that is
# both a different xclbin and a different MEASUREMENT: A multicasts down a column and B across a row,
# so each worker sits at the intersection of two DIFFERENT 4-core rendezvous and the feed-overlap
# quantity is non-uniform by construction. Worker 0 is the generator default and stays untagged so
# banked artifact names survive. filter-out, not filter, so an empty value yields no tag rather
# than a bare "w".
wrk_tag=$(if $(filter-out 0,$(wa_trace_worker)),w$(wa_trace_worker),)
# A traced MEMTILE adds a second trace unit and a second packet route, so it is a different xclbin
# again. -1 is off and stays untagged.
mt_tag=$(if $(filter-out -1,$(wa_trace_memtile)),mt$(wa_trace_memtile),)
nat_tag=$(if $(filter 1,${emulate_bfloat16_mmul_with_bfp16}),,nat)
re_tag=$(if $(filter 1,${round_even}),re,)$(if $(filter 1,${silu_f32_tail}),ft,)$(if $(filter 1,${silu_f32_tanh}),fh,)
panel_tag=$(if $(filter 0,${c_panel_width}),,panel${c_panel_width})
out_tag=$(if $(filter bf16,${dtype_out}),bf16out,)
krtp_tag=$(if $(filter 1,${k_loop_rtp}),krtp,)
resadd_tag=$(if $(filter 1,${mode_resadd}),resadd,)
# The rtp arm is a DIFFERENT INSTRUCTION STREAM on the SAME xclbin, so it needs its own artifact
# name or it overwrites the GEMM stream -- the same rule panel_tag carries.
rtpresadd_tag=$(if $(filter 1,${rtp_mode_resadd}),rtp4,)
apanel_tag=$(if $(filter 0,${a_panel_width}),,apanel${a_panel_width})
target_suffix=${M}x${K}x${N}_${m}x${k}x${n}_${n_aie_cols}c_${mode_tag}${out_tag}${panel_tag}${dep_tag}${abdep_tag}${l3dep_tag}${wrk_tag}${mt_tag}${re_tag}${nat_tag}${krtp_tag}${apanel_tag}${resadd_tag}${rtpresadd_tag}

use_iron=1
aie_py_src=whole_array_modal_iron.py

# Linear buffer allocation (bank-aware tends to overflow with the extra acc bufs)
buffer_aloc_flag=basic-sequential

# matmul object needs the bf16_f32 combo defines (mm.cc names symbols by combo).
MM_DEFINES=-Dbf16_f32_ONLY -DDIM_M=${m} -DDIM_K=${k} -DDIM_N=${n} -DVECTORIZED_ONLY
EPI_DEFINES=$(if $(filter 1,${mode4_bisect}), -DMODE4_BISECT_STORE_ONLY,)$(if $(filter 2,${mode4_bisect}), -DMODE4_BISECT_LOAD_A,)$(if $(filter 3,${mode4_bisect}), -DMODE4_BISECT_LOAD_AB,)$(if $(filter 4,${mode4_bisect}), -DMODE4_BISECT_LOAD_AB -DMODE4_BISECT_ADD,) -DEPI_M=${m} -DEPI_K=${k} -DEPI_N=${n} -DEPI_R=${epi_r} -DEPI_T=${epi_t}$(if $(filter 1,${round_even}), -DMODAL_ROUND_EVEN,)$(if $(filter 1,${drain_round_floor}), -DMODAL_DRAIN_ROUND_FLOOR,)$(if $(filter 1,${silu_f32_tail}), -DSILU_F32_TAIL,)$(if $(filter 1,${silu_f32_tanh}), -DSILU_F32_TANH,)
ifeq (${b_col_maj}, 1)
	MM_DEFINES+=-DB_COL_MAJ
endif

include ${srcdir}/../makefile-common

# Re-supply the aiecc-from-MLIR flow the blessed instance's new makefile-common dropped
# (shared with Makefile.modal.int8 and the Phase-3 whole_array siblings). srcdir points at
# the mlir-aie example dir this Makefile is copied into, so reach back to the source tree.
include ${srcdir}/../../../../../route_b_kernels/whole_array_fused/route_b_override.mk

# matmul object: bf16 in, f32 acc. KERNEL_DEFINES carries the BFP16_IREE / emulate flags from
# route_b_override.mk (fast tile) -- without it a fast-flagged build silently compiles the native kernel.
# Same identity trap as the epilogue object below: the name carries only m/k/n, but the content
# depends on MM_DEFINES + KERNEL_DEFINES (bfp16_iree, emulate_bfloat16_mmul_with_bfp16, B_COL_MAJ).
# Without the stamp, flipping any of those relinks the PREVIOUS variant's object into a new xclbin.
build/.mm_defines.stamp: FORCE
	@mkdir -p ${@D}
	@echo '${MM_DEFINES} emu=${emulate_bfloat16_mmul_with_bfp16} iree=${bfp16_iree} bcm=${b_col_maj}' | cmp -s - $@ \
	  || echo '${MM_DEFINES} emu=${emulate_bfloat16_mmul_with_bfp16} iree=${bfp16_iree} bcm=${b_col_maj}' > $@

build/mm_${m}x${k}x${n}.o: ${kernels_dir}/mm.cc build/.mm_defines.stamp
	mkdir -p ${@D}
	cd ${@D} && ${KERNEL_CC} ${KERNEL_CFLAGS} ${MM_DEFINES} ${KERNEL_DEFINES} -c $< -o ${@F}

# Epilogue object: f32 acc -> silu/narrow -> bf16 out.
#
# The object name carries only m/k/n, but its CONTENT depends on EPI_DEFINES (round_even,
# silu_f32_tail, silu_f32_tanh, ...). Without the stamp below, make sees an up-to-date .o and
# silently links the PREVIOUS variant's object into a differently-named xclbin -- so an A/B over
# those knobs compares two identical binaries and reports "no effect". That produced a false
# negative here on 2026-07-28 and nearly shipped a wrong conclusion; the stamp makes a defines
# change dirty the object.
build/.epi_defines.stamp: FORCE
	@mkdir -p ${@D}
	@echo '${EPI_DEFINES}' | cmp -s - $@ || echo '${EPI_DEFINES}' > $@
FORCE:
.PHONY: FORCE

build/mm_silu_epilogue_${m}x${k}x${n}.o: ${kernels_dir}/mm_silu_epilogue.cc build/.epi_defines.stamp
	mkdir -p ${@D}
	cd ${@D} && ${KERNEL_CC} ${KERNEL_CFLAGS} ${EPI_DEFINES} -c $< -o ${@F}
