##===- Makefile.resadd --------------------------------------------------===##
#
# Device-side f32 scaled residual-add xclbin (whole-block-resident fusion). Build:
#   make -f Makefile.resadd NPU2=1 rows=512 cols=1024 scale=0.5 stag=050 \
#        build/final_resadd_512x1024_s050.xclbin
# Produces final_resadd_${rows}x${cols}_s${stag}.xclbin + insts_resadd_${rows}x${cols}_s${stag}.txt.
# out[t,c] = a[t,c] + scale*b[t,c], f32. `scale` is baked into the MLIR/insts (one xclbin per
# value); `stag` is the filename tag (050 = 0.5, 100 = 1.0). residual_add.o is scale-independent.
#
srcdir := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))
include ${srcdir}/../../makefile-common
VPATH := ${srcdir}/../../../aie_kernels/aie2p

devicename ?= $(if $(filter 1,$(NPU2)),npu2,npu)
rows ?= 512
cols ?= 1024
scale ?= 0.5
stag ?= 050
# dtype=bf16 halves every streaming buffer (6 x D x 4B = 24588 B -> 12300 B of the core's
# 64 KB) and the DDR traffic with it; dtype=bf16b narrows only b, for an f32 residual stream fed
# by a bf16-out GEMM drain. The generator's --dtype and the kernel's -D flag MUST move together --
# they are two halves of one ABI -- so this one knob drives both, and the object name carries it
# so an f32 build never links a bf16 .o. Tag carries it too.
dtype ?= f32
ifeq ($(dtype),bf16)
RESADD_DEFINES = -DRESADD_BF16
dtsuf = _bf16
else ifeq ($(dtype),bf16b)
RESADD_DEFINES = -DRESADD_B_BF16
dtsuf = _bf16b
else
RESADD_DEFINES =
dtsuf =
endif
tag = resadd_${rows}x${cols}_s${stag}${dtsuf}

aie_py_src = residual_add_iron.py

all: build/final_${tag}.xclbin

build/residual_add${dtsuf}.o: residual_add.cc
	mkdir -p ${@D}
	cd ${@D} && ${PEANO_INSTALL_DIR}/bin/clang++ ${PEANOWRAP2P_FLAGS} ${RESADD_DEFINES} -c $< -o ${@F}

build/aie_${tag}.mlir: ${srcdir}/${aie_py_src}
	mkdir -p ${@D}
	python3 $< -d ${devicename} -r ${rows} -c ${cols} -s ${scale} -t 0 --dtype ${dtype} > $@

build/final_${tag}.xclbin: build/aie_${tag}.mlir build/residual_add${dtsuf}.o
	mkdir -p ${@D}
	cd ${@D} && aiecc --get-xclbin --get-npu-insts \
		--peano ${PEANO_INSTALL_DIR} \
		--xclbin-name=${@F} --npu-insts-name=insts_${tag}.txt aie_${tag}.mlir
