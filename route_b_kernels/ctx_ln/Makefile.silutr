##===- Makefile.silutr ----------------------------------------------------===##
#
# TRACED variant of Makefile.silu2 -- per-op device occupancy instrument (IRON enable_trace),
# connected 2026-07-30 in silu_iron.py (trace_size was already plumbed through the CLI/function
# signature but never wired to Program.enable_trace; this mirrors the enable_trace recipe
# already established for Makefile.lnaffcasttr verbatim). Build:
#   make -f Makefile.silutr NPU2=1 rows=1024 cols=400 build/final_silutr_1024x400.xclbin
# `cores` defaults to 1 (production 8 cores saturates the shim south ports for trace egress).
#
srcdir := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))
include ${srcdir}/../../makefile-common
VPATH := ${srcdir}/../../../aie_kernels/aie2p

devicename ?= $(if $(filter 1,$(NPU2)),npu2,npu)
trace_size ?= 65536
cores ?= 1
rows ?= 1024
cols ?= 400
silu_mode ?= 0
tag = silutr_${rows}x${cols}

aie_py_src = silu_iron.py

all: build/final_${tag}.xclbin

build/silu_brick.o: silu_brick.cc
	mkdir -p ${@D}
	cd ${@D} && ${PEANO_INSTALL_DIR}/bin/clang++ ${PEANOWRAP2P_FLAGS} -DSILU_MODE=${silu_mode} -c $< -o ${@F}

build/aie_${tag}.mlir: ${srcdir}/${aie_py_src}
	mkdir -p ${@D}
	python3 $< -d ${devicename} -r ${rows} -c ${cols} -t ${trace_size} -n ${cores} > $@

build/final_${tag}.xclbin: build/aie_${tag}.mlir build/silu_brick.o
	mkdir -p ${@D}
	cd ${@D} && aiecc --dump-intermediates --get-xclbin --get-npu-insts \
		--no-xchesscc --no-xbridge --peano ${PEANO_INSTALL_DIR} \
		--xclbin-name=${@F} --npu-insts-name=insts_${tag}.txt aie_${tag}.mlir
