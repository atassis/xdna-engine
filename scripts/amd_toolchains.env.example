# AMD-toolchain target repo paths for scripts/setup_amd_toolchains.sh.
#
# Copy to `scripts/amd_toolchains.env` (gitignored) and adjust. This keeps absolute
# fork/checkout paths OUT of git -- the committed scripts only read these vars.
#
#   cp scripts/amd_toolchains.env.example scripts/amd_toolchains.env
#
# None of these have a default -- scripts/amd_paths.sh assumes no sibling-checkout
# layout, so IRON_DIR is REQUIRED and the rest are empty unless set here.
# mlir-aie is the in-repo submodule by default (no var needed).

IRON_DIR=/path/to/IRON                    # required: the IRON operator-library checkout
# XRT_SRC_DIR=/path/to/XRT-src            # XRT source (aiebu-asm lives under it)
# MLIR_AIE_DIR="<repo>/mlir-aie"          # default: the vendored submodule
# LLVM_AIE_DIR=/path/to/llvm-aie          # empty by default = do NOT patch Peano; set to opt in
# MLIR_AIR_DIR=/path/to/mlir-air          # empty by default = do NOT patch mlir-air; set to opt in
